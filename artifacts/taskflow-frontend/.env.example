# API Configuration
# Leave unset to auto-detect the Expo host and call the backend on port 3000.

# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# Physical Android/iOS device on the same Wi-Fi:
# Replace with your computer IP from ipconfig.
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000/api
