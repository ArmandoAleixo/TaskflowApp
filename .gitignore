dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared
web-build

# build artifacts and generated runtime files
artifacts/**/dist/
artifacts/**/build/
*.log
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# local environment files
.env
.env.*
!.env.example
artifacts/**/.env
artifacts/**/.env.*
!artifacts/**/.env.example
!artifacts/taskflow-backend/.env

# generated documents and bulky local assets
*.pdf
attached_assets/

# dependencies
node_modules
package-lock.json

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

